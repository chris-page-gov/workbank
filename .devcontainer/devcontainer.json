{
  "name": "Workbank Development Environment (Codex Universal)",
  "image": "ghcr.io/openai/codex-universal:latest",
  
  "containerEnv": {
    "CODEX_ENV_PYTHON_VERSION": "3.12",
    "CODEX_ENV_NODE_VERSION": "20",
    "CODEX_ENV_RUST_VERSION": "1.87.0",
    "CODEX_ENV_GO_VERSION": "1.23.8",
    "CODEX_ENV_SWIFT_VERSION": "6.1"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-vscode.vscode-json",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/root/.pyenv/shims/python"
      }
    }
  },

  "forwardPorts": [8000, 8080, 5000],

  "postCreateCommand": "bash --login -c 'pip install --upgrade pip && pip install pandas numpy matplotlib seaborn jupyter notebook ipykernel'",

  "remoteUser": "root"
}
